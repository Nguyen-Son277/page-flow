{
  "name": "pageflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "admin:create": "tsx scripts/admin.ts", "admin:reset": "tsx scripts/admin.ts --reset",
    "demo:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.61.0",
    "cheerio": "^1.1.2",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.9",
    "pdf-parse": "1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
