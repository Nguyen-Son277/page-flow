DATABASE_URL=postgresql://pageflow:pageflow@localhost:5432/pageflow
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
# Generate: openssl rand -hex 32. Required outside demo; never commit the real key.
TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Set a supported version after checking current Meta documentation.
META_GRAPH_VERSION=
# Production remains disabled until permissions and current messaging policies are checked.
META_SEND_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
DEMO_MODE=true
# 0 preserves data. Set >=7 explicitly to clean resolved, inactive conversations.
RETENTION_DAYS=0
# Optional resource limits; the defaults below are applied when unset. Per-IP limits are
# only trustworthy behind a reverse proxy that overwrites x-forwarded-for.
# LOGIN_IP_RATE_LIMIT=30
# AI_TEST_RATE_LIMIT=30
# SEND_RATE_LIMIT=60
# SSE_MAX_CONNECTIONS=200
# Hours between worker checks of each connected Page token (0 disables the check).
# TOKEN_CHECK_HOURS=6
